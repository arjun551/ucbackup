rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /payment-proofs/{uid}/{file} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.role in ['moderator','admin','superadmin']);
      allow create: if request.auth != null && request.auth.uid == uid && resource == null
        && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }
    match /avatars/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    match /{kind}/{file=**} {
      allow read: if kind != 'payment-proofs';
      allow write: if request.auth != null && request.auth.token.role in ['moderator', 'admin', 'superadmin']
        && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
  }
}
